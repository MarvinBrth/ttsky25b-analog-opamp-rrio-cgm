* Private characterization / teaching comparison: pex
.lib "../../models/selected.lib.spice" tt
.include "../../includes/pex.inc"
.temp 25
.options klu itl1=500 reltol=0.0001
.nodeset v(out)=1.65
VDD vapwr 0 3.3 AC 0
VDIG vd1v8 0 1.8 AC 0
VIN inp 0 DC 0.3 PWL(0 0.3 1u 0.3 1.01e-06 3.0 8e-06 3.0 8.01e-06 0.3) AC 0
VJ inn out DC 0 AC 0
IT 0 out DC 0 AC 0
ILOAD out 0 0
CL out 0 20p
XDUT vapwr out inp inn 0 vd1v8 pex_dut

.control
set numdgt=15
set wr_singlescale
set wr_vecnames
set filetype=ascii
op
wrdata op.dat v(out) i(VDD) @m.xdut.xraw.x11.msky130_fd_pr__pfet_g5v0d10v5[id]
write op.raw all
save v(out) v(inp) i(VDD) @m.xdut.xraw.x11.msky130_fd_pr__pfet_g5v0d10v5[id]
tran 2e-09 1.4e-05 0 2e-09
wrdata step.dat v(out) v(inp) i(VDD) @m.xdut.xraw.x11.msky130_fd_pr__pfet_g5v0d10v5[id]

quit
.endc
.end
